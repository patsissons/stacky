{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stacky-site",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  "routes": [{ "pattern": "stacky.lgtm.page", "custom_domain": true }],
  "workers_dev": false,
}
